# Copy to .env and adjust. All settings are optional.
HEART_MODEL_PATH=models/heart_model.joblib
HEART_METADATA_PATH=models/metadata.json
HEART_LOG_LEVEL=INFO
HEART_LOG_JSON=true
HEART_LOG_PREDICTIONS=true
HEART_PREDICTION_LOG_PATH=logs/predictions.jsonl
HEART_MAX_BATCH_SIZE=1000
HEART_TOP_FACTORS=5
# Require an X-API-Key header on /predict endpoints (leave unset to disable)
# HEART_API_KEY=change-me
